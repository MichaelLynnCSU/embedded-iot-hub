[Unit]
Description=Doorbell Ingest and Inference Service
# DEADLOCK PREVENTION: doorbell_daemon uses /doorbell_result SHM and writes
# results consumed by data-controller. Must start after data-controller
# to guarantee SHM is initialized before doorbell results are written.
After=network.target data-controller.service
Requires=data-controller.service
[Service]
Type=simple
User=debian
Environment=LD_LIBRARY_PATH=/opt/inference/lib
WorkingDirectory=/opt/inference/app
ExecStart=/opt/inference/app/doorbell_daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
