[Unit]
Description=Person Detection Inference Service
# DEADLOCK PREVENTION: inference_daemon reads SHM written by data-controller.
# Must start after data-controller to guarantee SHM is initialized.
After=network.target data-controller.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/inference/lib
ExecStart=/opt/inference/app/inference_daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
