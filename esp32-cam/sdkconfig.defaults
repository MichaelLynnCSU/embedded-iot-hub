# FreeRTOS / IDF safety — required for Trinity to report accurate fault context
CONFIG_FREERTOS_WATCHPOINT_ON_STACK_OVERFLOW=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_HEAP_POISONING_LIGHT=y
# PSRAM — required for camera frame buffer allocation
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE_64B=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Stack overflow hardening (2026-06-13)
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
